{
  "license": "MIT",
  "name": "comic_translation",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "release:preflight": "powershell -ExecutionPolicy Bypass -File ..\\scripts\\release_app_preflight.ps1 -App comic_translation",
    "predeploy": "npm run release:preflight && npm run build",
    "deploy": "gh-pages -d dist",
    "postbuild": "node scripts/web-security.mjs --verify-dist && node scripts/third-party-notices.mjs --verify-dist",
    "test": "node --test",
    "prebuild": "npm test",
    "licenses:generate": "node scripts/third-party-notices.mjs --write-source",
    "licenses:verify": "node scripts/third-party-notices.mjs --verify-dist"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "gh-pages": "6.3.0",
    "globals": "^17.4.0",
    "vite": "^8.0.4"
  }
}
